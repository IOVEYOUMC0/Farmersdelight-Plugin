
.gradle/
.gradle-user-home/
build/
bin/
out/
*.class
*.jar
# Vendored compile-only dependency (custom Folia build of UltimateAdvancementAPI, not on any
# public Maven repo). Tracked so a fresh checkout / CI can compile.
!/libs/*.jar

.idea/
*.iml
.vscode/

local.properties
.local/

# Python bytecode from the tools/ checkers, which CI runs and developers run locally.
__pycache__/
*.pyc

# CraftEngine is resolved from Maven for every build. The paid distribution jars are only ever used locally by
# the workspace-level tools/check_ce_symbols.py (monorepo parent directory), which takes explicit paths:
#   python tools/check_ce_symbols.py <jar> --ce 26.9.1=path/core.jar;path/bukkit.jar;path/proxy.jar
/libs/craft-engine-*.jar
